{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/weathercube.svg", "dest": "/public/weathercube.svg" },
    { "src": "/weathercube.png", "dest": "/public/weathercube.png" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/(.*)", "dest": "/index.js" }
  ]
}